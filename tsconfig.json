{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    ".vercel",
    "scripts/preview-vercel.mjs"
  ],
  "compilerOptions": {
    "plugins": [{ "name": "@shopify/hydrogen/ts-plugin" }],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
