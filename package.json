{
  "name": "nightshift-vinyl",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "hydrogen skills check --mode=warn && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && hydrogen gql check",
    "check:graphql": "hydrogen gql check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "python3 scripts/smoke-test.py",
    "preview:vercel": "node --env-file-if-exists=.env scripts/preview-vercel.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/vercel": "^11.0.16",
    "@shopify/hydrogen": "^2026.10.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
